# Auth & Session Secret (change in production!)
AUTH_SECRET="kleen-data-room-super-secret-change-in-production-2026"

# Optional Pre-configured Google Drive Read-Only Mirroring
# Set a Google Drive Root Folder ID to mirror directly into Kleen Data Room:
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Option 1: Service Account JSON (share your Drive folder as Viewer with the client_email)
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Option 2: OAuth 2.0 Credentials (for "Connect Google Drive" button in Settings)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/oauth/callback"

# Option 3: API Key (works if the target Drive folder is shared as "Anyone with the link - Viewer")
GOOGLE_API_KEY=""
